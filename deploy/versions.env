# Pinned data-plane sources (rule P-17: our forks, fixed commits; a bump is a
# commit of its own). Read by CI and by docs/RELEASE.md.

# Xray: REALITY and the inner stage. Same commit as arngory/niko
# .github/xray-interop.env (v26.10.31).
XRAY_REPOSITORY="https://github.com/arngory/xray-core.git"
XRAY_COMMIT="a4a3dff5b20c2faae567b742c172c7b95e75c083"

# niko-server (front and backends): its own repository, arngory/niko-server,
# kept by the raycontrol session; releases are tagged vX.Y.Z there. v0.8.0:
# the front on UDP 53 (DNS tunnels: dnstt and masterdns backends), on TCP 443
# (tcpmux: REALITY by PROXY v2, DoH, naive and the yggdrasil backend by passed
# sockets, R2-15, R4-15) and on UDP 443 (udpmux: the Hysteria2 backends, DoH3
# and naive-quic, R3-4, R3-5; IP_PMTUDISC_PROBE, nothing fragmented); the
# Hysteria2 backends route the probe name and answer for their sessions by
# client address, and by user one by one (own, R4-20); salamander word by
# word and without cutting full packets; dnstt with dnsauth-v1 (auth,
# auth_keys_file); v0.8.2: UDP 53 with SO_REUSEADDR, beside systemd-resolved's
# stub; v0.8.3: dnstt through resolvers with an EDNS size under 1232, NODATA
# for queries the tunnel does not take, dnsprobe-v1 in the DNS front
# (dns.probe_key_file, zones[].probe); v0.9.0: SOA and NS at the apex of
# dnstt zones (zones[].ns), a resolver's retry gets the first answer's
# data; v0.10.0: dnsseal-v1 (seal, seal_key_file; zones[].seal_pad), a
# backend's answer only to a waiting query and within 1232 bytes, dnstt
# bounded under floods (a session's first packet, 512 sessions, 8 a
# device, 256 streams a session, 60 s handshakes), dnsauth and seal keys
# reread by content, masterdns from the client's fork at c9c3ab3; v0.11.0:
# masterdns sealed answers and device tags, spare dnstt zones, stats
# sockets; v0.12.0: dnsauth-v2 (auth_hint: a device's key by the hint in
# its tag, outside the scan budget), Hysteria2 streams half-closed;
# v0.13.0: slipstream zones in the DNS front (the device tag checked there);
# v0.14.0: backends.<name>.devices, the query's device to a slipstream
# server in IPC version 2 (its --max-connections-per-device); v0.14.1:
# Hysteria2 answers a TCP stream right after the dial, with the reason on
# failure (links carry niko-ack=1, internal/sub TestNikoAckPin). The
# yggdrasil-go core comes from arngory/yggdrasil-go (0.5.15 with
# LinkDialer).
# Releases of raycontrol carry it; rayctl install puts it in
# /usr/local/libexec/raycontrol.
NIKO_SERVER_RELEASES="https://github.com/arngory/niko-server/releases"
NIKO_SERVER_TAG="v0.14.1"
NIKO_SERVER_REPOSITORY="https://github.com/arngory/niko-server.git"
NIKO_SERVER_COMMIT="05e4eb309b7fc8fa4a6f4cab7ee987bfecee1063"
# SHA-256 of the release binaries: a raycontrol release ships exactly these
# (scripts/niko-server.sh checks them), under the release's own signature.
NIKO_SERVER_SHA256_AMD64="9800188c067caa616b6c7a975316e65c3c1b1a792d4a60da4ed4a43e74aafd3a"
NIKO_SERVER_SHA256_ARM64="e188fc844b072081c4185103026d66b2f76b49ddca5d896c2f9b6e5717041b56"
# slipstream-server (DNS tunnel over QUIC, raycontrol docs/spec/slipstream-v1.md):
# the fork arngory/slipstream, branch server/hardening, static (musl), released
# by tag server-vX.Y.Z; scripts/slipstream-server.sh checks these hashes. The
# slipstream service runs it (v0.16.0). server-v0.2.0 (v0.17.0):
# --max-connections-per-device by the device niko-server v0.14.0 names (IPC
# version 2), places counted by the server; it and the front go together.
SLIPSTREAM_SERVER_RELEASES="https://github.com/arngory/slipstream/releases"
SLIPSTREAM_SERVER_TAG="server-v0.2.0"
SLIPSTREAM_SERVER_REPOSITORY="https://github.com/arngory/slipstream.git"
SLIPSTREAM_SERVER_COMMIT="dc5f41d3b5c5995221205ba8a0323a16ebc7d475"
SLIPSTREAM_SERVER_SHA256_AMD64="59a0c3eb2a8bbbd8bdbd54c9ae8330d6e5e0dd328acab0e27d2f6f574d377b3f"
SLIPSTREAM_SERVER_SHA256_ARM64="e982d06cc11ab5a66b1f19e2715318824caa3609607a8dbb94fbd68db934224f"
# The client of the same fork (branch client/pin-alpn-sni, the client's own:
# pin, ALPN, server name, dnsauth-v2), built by CI for the end-to-end test
# only (TestSlipstreamWithNikoServer); never shipped.
SLIPSTREAM_CLIENT_COMMIT="4c7c01a9fd336f29b841518cd4fce247cb0bdfb1"
