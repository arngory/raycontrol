# Pinned data-plane sources (rule P-17: our forks, fixed commits; a bump is a
# commit of its own). Read by CI and by docs/RELEASE.md.

# Xray: REALITY and the inner stage. Same commit as arngory/niko
# .github/xray-interop.env (v26.10.31).
XRAY_REPOSITORY="https://github.com/arngory/xray-core.git"
XRAY_COMMIT="a4a3dff5b20c2faae567b742c172c7b95e75c083"

# niko-server (front and backends): code in arngory/sing-box (cmd/niko-server,
# commit 34eaa8c), signed releases in arngory/niko. v0.1.1 serves the DNS
# tunnels (front on UDP 53, dnstt and masterdns backends); v0.1.0 must not be
# used. Releases of raycontrol carry it; rayctl install puts it in
# /usr/local/libexec/raycontrol.
NIKO_SERVER_RELEASES="https://github.com/arngory/niko/releases"
NIKO_SERVER_TAG="niko-server-v0.1.1"
NIKO_SERVER_REPOSITORY="https://github.com/arngory/sing-box.git"
NIKO_SERVER_COMMIT="34eaa8c"
# SHA-256 of the release binaries: a raycontrol release ships exactly these
# (scripts/niko-server.sh checks them), under the release's own signature.
NIKO_SERVER_SHA256_AMD64="c38899288f727c90a1662bb2868d6853c291866eef7e8a0b35b1a82dbed3774c"
NIKO_SERVER_SHA256_ARM64="f6f020e9f36021d04912bf002d2fe0457f5968941eb500d3f642edab3f7dba27"
